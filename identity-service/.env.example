# ──── Server ────
PORT=4001
NODE_ENV=development

# ──── MongoDB ────
MONGO_URI=mongodb://admin:admin_secret@localhost:27017/logistics_platform?authSource=admin

# ──── Redis ────
REDIS_URL=redis://:redis_secret@localhost:6379

# ──── JWT ────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
