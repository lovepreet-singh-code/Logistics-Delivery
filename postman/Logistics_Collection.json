{
  "info": {
    "name": "Logistics E2E Business Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Phase 1: Platform Setup (Admin)",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"adminToken\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Franchise",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"franchiseId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"City Hub\",\n  \"location\": \"Downtown\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/franchise",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "franchise"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Pincode",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pincode\": \"10001\",\n  \"franchiseId\": \"{{franchiseId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/franchise/{{franchiseId}}/pincode",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "franchise",
                "{{franchiseId}}",
                "pincode"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Add Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"vehicleId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Truck\",\n  \"capacity\": \"1000kg\",\n  \"franchiseId\": \"{{franchiseId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/vehicle",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "vehicle"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Phase 2: Ordering (Customer)",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"pass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "register"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set(\"customerToken\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"pass123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Check Serviceability",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/customer/serviceability?pincode=10001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "serviceability"
              ],
              "query": [
                {
                  "key": "pincode",
                  "value": "10001"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Place Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"orderId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item\": \"Laptop\",\n  \"pickupPincode\": \"10001\",\n  \"deliveryPincode\": \"10002\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/order",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "customer",
                "order"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Phase 3: Dispatch (Agent)",
      "item": [
        {
          "name": "Create Manifest",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"manifestId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"orders\": [\n    \"{{orderId}}\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agent/manifest",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "manifest"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/agent/order/{{orderId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "order",
                "{{orderId}}",
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Track Order",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agent/order/{{orderId}}/track",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agent",
                "order",
                "{{orderId}}",
                "track"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
