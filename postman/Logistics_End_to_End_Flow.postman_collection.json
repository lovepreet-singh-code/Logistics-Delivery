{
  "info": {
    "name": "Logistics End-to-End Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Phase 1: Admin Setup",
      "item": [
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"adminToken\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"System Admin\",\n  \"email\": \"admin@logistics.com\",\n  \"password\": \"password123\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Create Franchise",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.environment.set(\"franchiseId\", jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Delhi Central Hub\",\n  \"address\": \"Connaught Place, New Delhi\",\n  \"serviceablePincodes\": [\"110001\", \"110017\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/franchises", "host": ["{{baseUrl}}"], "path": ["api", "franchises"] }
          }
        },
        {
          "name": "Add Vehicle",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.environment.set(\"vehicleId\", jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"DL-1A-1234\",\n  \"franchiseId\": \"{{franchiseId}}\",\n  \"capacity\": {\n    \"maxWeightKg\": 1000,\n    \"maxVolumeCm3\": 500000\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/fleet/vehicles", "host": ["{{baseUrl}}"], "path": ["api", "fleet", "vehicles"] }
          }
        }
      ]
    },
    {
      "name": "Phase 2: Ordering",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data.token) {",
                  "    pm.environment.set(\"customerToken\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"customer\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Place Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data && jsonData.data._id) {",
                  "    pm.environment.set(\"orderId\", jsonData.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupAddress\": { \"fullAddress\": \"Connaught Place, New Delhi\", \"pinCode\": \"110001\" },\n  \"deliveryAddress\": { \"fullAddress\": \"Saket, New Delhi\", \"pinCode\": \"110017\" },\n  \"parcelDetails\": { \"weightKg\": 5, \"description\": \"Electronics\", \"dimensions\": { \"lengthCm\": 10, \"widthCm\": 10, \"heightCm\": 10 } }\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api", "orders"] }
          }
        }
      ]
    },
    {
      "name": "Phase 3: Dispatch & Delivery",
      "item": [
        {
          "name": "Create Mock Manifest",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    if (jsonData.data.manifest && jsonData.data.manifest._id) {",
                  "        pm.environment.set(\"manifestId\", jsonData.data.manifest._id);",
                  "    }",
                  "    if (jsonData.data.deliveryId) {",
                  "        pm.environment.set(\"deliveryId\", jsonData.data.deliveryId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agentId\": \"60d5ecb8b392d7001f3e3905\",\n  \"orderId\": \"{{orderId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/dispatch/debug/create-mock-manifest", "host": ["{{baseUrl}}"], "path": ["api", "dispatch", "debug", "create-mock-manifest"] }
          }
        },
        {
          "name": "PATCH Delivery Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/deliveries/{{deliveryId}}", "host": ["{{baseUrl}}"], "path": ["api", "deliveries", "{{deliveryId}}"] }
          }
        },
        {
          "name": "Track Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is DELIVERED\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql(\"DELIVERED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api", "orders", "{{orderId}}"] }
          }
        }
      ]
    }
  ]
}
